{
  "name": "studypilot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/validation.test.ts",
    "test:integration": "node --test tests/api-crud.test.ts",
